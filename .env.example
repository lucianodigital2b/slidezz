APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Pricing (config/plans.php) ───────────────────────────────────────────────
# Managed AI-image allowance per billing cycle (credits meter the only real COGS;
# carousels are unlimited, BYOK images are free). Also drives the "N imagens IA/mês"
# feature line shown on the plan cards.
PLAN_STARTER_CREDITS=60
PLAN_PRO_CREDITS=150
PLAN_AGENCY_CREDITS=400

# Price labels — DISPLAY ONLY (what the pricing UI shows).
STRIPE_PRICE_STARTER_MONTHLY_LABEL="$29/mo"
STRIPE_PRICE_STARTER_ANNUAL_LABEL="$19/mo"
STRIPE_PRICE_STARTER_MONTHLY_BRL_LABEL="R$67/mês"
STRIPE_PRICE_STARTER_ANNUAL_BRL_LABEL="R$47/mês"
STRIPE_PRICE_PRO_MONTHLY_LABEL="$59/mo"
STRIPE_PRICE_PRO_ANNUAL_LABEL="$39/mo"
STRIPE_PRICE_PRO_MONTHLY_BRL_LABEL="R$127/mês"
STRIPE_PRICE_PRO_ANNUAL_BRL_LABEL="R$87/mês"
STRIPE_PRICE_AGENCY_MONTHLY_LABEL="$129/mo"
STRIPE_PRICE_AGENCY_ANNUAL_LABEL="$99/mo"
STRIPE_PRICE_AGENCY_MONTHLY_BRL_LABEL="R$247/mês"
STRIPE_PRICE_AGENCY_ANNUAL_BRL_LABEL="R$177/mês"

# Stripe Price ids — what is ACTUALLY charged. Create these Prices in Stripe
# (USD + BRL, monthly + annual, all three tiers) and paste the price_... ids here.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_STARTER_MONTHLY_BRL=
STRIPE_PRICE_STARTER_ANNUAL_BRL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY_BRL=
STRIPE_PRICE_PRO_ANNUAL_BRL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY_BRL=
STRIPE_PRICE_AGENCY_ANNUAL_BRL=

# Launch offer: lifetime access, ONE-TIME Stripe Prices (mode: payment, not
# recurring). Create a $149 USD price and a R$149 BRL price and paste the ids.
STRIPE_PRICE_LIFETIME_LABEL="$149"
STRIPE_PRICE_LIFETIME_BRL_LABEL="R$149"
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_LIFETIME_BRL=


